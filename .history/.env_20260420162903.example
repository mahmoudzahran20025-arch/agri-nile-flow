# Agri-Nile Flow — Environment Variables Template
# Copy this file to .env and fill in your values
# NEVER COMMIT .env — this file is safe to commit

# ============================================================
# Cloudflare Workers Environment
# ============================================================
# DO NOT SET HERE — use: printf "your_secret" | npx wrangler secret put JWT_SECRET
# This is handled by Cloudflare Worker Secrets, not in code
# JWT_SECRET=your_secret_here

# ============================================================
# Database Configuration
# ============================================================
# Database is bound via wrangler.toml binding
# No manual configuration needed — automatic via Cloudflare D1
DATABASE_NAME=agri-nile-flow-data-lake

# ============================================================
# Frontend Configuration
# ============================================================
# Auto-detected from browser origin:
#   - Production: https://fb7b4223.agri-nile-flow-lake.pages.dev
#   - Local Dev: http://localhost:5173
VITE_API_URL=http://localhost:4173/api

# ============================================================
# Company Configuration
# ============================================================
# Default company_id for local development (extracted from JWT in production)
VITE_COMPANY_ID=1

# ============================================================
# Development Settings
# ============================================================
NODE_ENV=development
DEBUG=false

# ============================================================
# Session Configuration
# ============================================================
# JWT expiration (in seconds)
JWT_EXPIRY_SECONDS=86400

# ============================================================
# CORS Configuration (handled by backend, for reference)
# ============================================================
# Allowed origins:
# - https://fb7b4223.agri-nile-flow-lake.pages.dev
# - http://localhost:5173
# - http://localhost:4173
