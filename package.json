{
  "name": "agri-nile-flow",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev:web": "cd web && npm run dev",
    "db:init": "wrangler d1 execute agri-nile-flow-data-lake --remote --file=./schema.sql",
    "build:web": "cd web && npm install && npm run build",
    "deploy": "npm run build:web && npx wrangler pages deploy web/dist --project-name=agri-nile-flow-lake && wrangler deploy",
    "type-check": "tsc --noEmit",
    "verify:p0:event-linkage": "node p0_event_linkage_verification.js",
    "import:pipeline:prepare": "node prepare_import_pipeline.js",
    "import:pipeline:strict": "node prepare_import_pipeline.js --strict",
    "import:sql:clean": "node generate_clean_import_sql.js",
    "import:execute:clean": "node import_execute_clean.js"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.7.6",
    "hono": "^4.6.0",
    "recharts": "^3.8.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241127.0",
    "typescript": "^5.6.0",
    "wrangler": "^4.83.0",
    "xlsx": "^0.18.5"
  }
}
